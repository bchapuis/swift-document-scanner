    "Camera access is required to scan documents. Please enable it in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerazugriff ist erforderlich, um Dokumente zu scannen. Bitte aktivieren Sie ihn in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to scan documents. Please enable it in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso a la cámara para escanear documentos. Por favor, actívelo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est requis pour numériser les documents. Veuillez l'activer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è necessario per scansionare i documenti. Abilitalo nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントをスキャンするにはカメラへのアクセスが必要です。設定で有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서를 스캔하려면 카메라 액세스가 필요합니다. 설정에서 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera é necessário para digitalizar documentos. Por favor, ative-o em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования документов требуется доступ к камере. Пожалуйста, включите его в Настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描文档需要相机访问权限。请在设置中启用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا مطلوب لمسح المستندات. يرجى تمكينه في الإعدادات."
          }
        }
      }
    },
